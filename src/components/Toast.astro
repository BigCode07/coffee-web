---
import { site } from "../config/site";
---

<div
	id="toast"
	role="status"
	aria-live="polite"
	data-message={site.soonMessage}
	class="pointer-events-none fixed bottom-4 left-1/2 z-20 w-[min(92vw,26rem)] -translate-x-1/2 rounded-md border border-accent bg-surface-elevated px-4 py-3 text-center text-sm text-text opacity-0 transition-opacity duration-200 motion-reduce:transition-none"
>
</div>

<script>
	const toast = document.getElementById("toast");
	let timer: number | undefined;

	if (toast) {
		document.addEventListener("click", (event) => {
			const target = (event.target as Element).closest("[data-soon]");
			if (!target) return;
			toast.textContent = toast.dataset.message ?? "";
			toast.classList.remove("opacity-0");
			window.clearTimeout(timer);
			timer = window.setTimeout(() => {
				toast.classList.add("opacity-0");
				toast.textContent = "";
			}, 3500);
		});
	}
</script>
