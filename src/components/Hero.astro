---
import { roast } from "../config/site";
import FlameIcon from "./FlameIcon.astro";
---

<section class="container-page flex flex-wrap items-center gap-10 pt-10 pb-12 md:gap-12 md:pt-12 md:pb-18">
	<div class="flex flex-[1_1_440px] flex-col gap-6">
		<p class="eyebrow">Café de especialidad · Tostado semanal</p>
		<h1
			class="font-display text-[clamp(44px,6vw,80px)] leading-[1.04] font-semibold tracking-[-0.01em]"
		>
			Cada grano,<br /><em class="font-normal text-accent-hover">una historia.</em>
		</h1>
		<p class="max-w-[460px] text-lg text-text-muted">
			Cafés de origen, tostados en pequeños lotes y molidos a tu medida. Del
			productor a tu taza.
		</p>
		<div class="mt-2 flex flex-wrap gap-3.5">
			<a href="#destacados" class="btn-primary min-h-13 px-7.5 text-base"
				>Comprar café</a
			>
			<a href="#origen" class="btn-ghost min-h-13 px-7.5 text-base"
				>Conocé nuestro origen</a
			>
		</div>
	</div>
	<div
		class="relative flex aspect-[4/3] max-w-[520px] md:aspect-[4/5] flex-[1_1_380px] flex-col items-center justify-center gap-3.5 rounded-sm border border-dashed border-border bg-surface p-8 text-center text-text-muted"
	>
		<p
			class="absolute top-4 left-4 flex md:top-auto md:bottom-4 items-center gap-2 rounded-full border border-accent bg-bg px-3.5 py-2 text-sm font-semibold text-text"
		>
			<FlameIcon size={16} class="text-accent" />
			{roast.lastLabel}
		</p>
		<svg aria-hidden="true" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#C8743A" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12v4a6 6 0 0 1-6 6h0a6 6 0 0 1-6-6z"></path><path d="M16 11h1.5a2.5 2.5 0 0 1 0 5H16"></path><path d="M8 3c0 1.5 1 1.5 1 3M12 3c0 1.5 1 1.5 1 3"></path></svg>
		<span class="text-sm tracking-[0.08em] uppercase">Foto principal</span>
		<span class="max-w-65 text-[13px]"
			>Taza blanca con granos cayendo, fondo negro, luz cálida lateral.</span
		>
	</div>
</section>
