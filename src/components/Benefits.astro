---
import { benefits } from "../config/site";

const icons = [
	'<path d="M2 7h11v9H2zM13 10h4l3 3v3h-7"></path><circle cx="6" cy="17.5" r="1.8"></circle><circle cx="16.5" cy="17.5" r="1.8"></circle>',
	'<path d="M12 3c3 4 6 6 6 10a6 6 0 0 1-12 0c0-2 1-3.5 2-5 .5 2 1.5 3 2.5 3 0-3 0-5 1.5-8z"></path>',
	'<path d="M7 21h10M8 21l1-9h6l1 9M7 12h10l-1-4H8zM12 8V4M10 4h4"></path>',
	'<rect x="3" y="6" width="18" height="12" rx="2"></rect><path d="M3 10h18M7 15h3"></path>',
];
---

<section
	aria-label="Beneficios"
	class="border-y border-surface bg-surface"
>
	<ul
		class="container-page flex list-none flex-wrap justify-between gap-x-10 gap-y-6 py-7"
	>
		{
			benefits.map((text, i) => (
				<li class="flex flex-[1_1_220px] items-center gap-3.5 text-[15px]">
					<svg
						aria-hidden="true"
						width="30"
						height="30"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.4"
						class="shrink-0 text-accent"
						stroke-linecap="round"
						stroke-linejoin="round"
						set:html={icons[i]}
					/>
					<span>{text}</span>
				</li>
			))
		}
	</ul>
</section>
