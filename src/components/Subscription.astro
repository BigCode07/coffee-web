---
import { plans } from "../config/site";
---

<section id="suscripcion" class="container-page pt-16 pb-10 md:pt-24 md:pb-14">
	<div
		class="flex flex-col gap-8 rounded-lg bg-surface-elevated p-[clamp(28px,5vw,64px)]"
	>
		<div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-4">
			<div class="max-w-140">
				<p class="eyebrow mb-2.5 text-accent-hover">Suscripción</p>
				<h2
					class="font-display text-[clamp(32px,4vw,48px)] leading-[1.1] font-semibold"
				>
					Recibí café fresco cada mes
				</h2>
			</div>
			<p class="max-w-90 text-text">
				Elegí frecuencia y molienda. Pausá o cancelá cuando quieras.
			</p>
		</div>
		<div class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-4">
			{
				plans.map((plan) => (
					<div
						class:list={[
							"relative flex flex-col gap-2.5 rounded-md border p-6",
							plan.featured
								? "border-accent bg-bg"
								: "border-border bg-surface",
						]}
					>
						{plan.featured && (
							<span class="absolute -top-3 left-6 rounded-full bg-accent px-2.5 py-1 text-[11px] font-semibold tracking-[0.08em] text-bg uppercase">
								Más elegido
							</span>
						)}
						<h3 class="font-display text-2xl">{plan.name}</h3>
						<p class="text-[15px] text-text-muted">{plan.weight}</p>
						<span class="text-[22px] font-semibold text-accent-hover">
							{plan.price}/mes
						</span>
						<button
							type="button"
							data-soon
							class:list={[
								"mt-2 min-h-11.5",
								plan.featured ? "btn-primary" : "btn-ghost",
							]}
							aria-label={`Elegir plan ${plan.name}`}>Elegir plan</button
						>
					</div>
				))
			}
		</div>
	</div>
</section>
