---
---

<section class="border-t border-surface">
	<div
		class="mx-auto flex max-w-190 flex-col items-center gap-4 px-6 py-14 text-center md:py-20"
	>
		<h2 class="section-title">
			10&nbsp;% off en tu primera compra
		</h2>
		<p class="text-text-muted">
			Sumate al newsletter: lanzamientos, lotes limitados y guías de
			preparación.
		</p>
		<form class="mt-3 flex w-full max-w-130 flex-wrap gap-2.5">
			<label for="nl-email" class="sr-only">Email</label>
			<input
				id="nl-email"
				name="email"
				type="email"
				autocomplete="email"
				required
				placeholder="tu@email.com"
				class="min-h-13 flex-[1_1_260px] rounded-full border border-border bg-surface px-5 text-text transition-[border-color,box-shadow] duration-150 placeholder:text-text-muted"
			/>
			<button type="submit" class="btn-primary min-h-13 px-7">
				Suscribirme
			</button>
		</form>
	</div>
</section>
