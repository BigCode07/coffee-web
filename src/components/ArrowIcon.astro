---
interface Props {
	size?: number;
	class?: string;
}

const { size = 16, class: className } = Astro.props;
---

<svg
	aria-hidden="true"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
>
	<path d="M5 12h14M13 6l6 6-6 6"></path>
</svg>
