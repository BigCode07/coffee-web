---
import { categories } from "../config/site";
---

<section aria-labelledby="cat-title" class="container-page section-y">
	<h2 id="cat-title" class="section-title mb-8">
		Explorá por categoría
	</h2>
	<div
		class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(200px,1fr))] sm:gap-4"
	>
		{
			categories.map((category) => (
				<a
					href="#destacados"
					class:list={[
						"group flex min-h-20 flex-col justify-between rounded-md border p-4 text-text no-underline transition-colors hover:border-accent sm:min-h-28 sm:p-5",
						category.highlight
							? "col-span-2 border-border bg-surface-elevated sm:col-span-1"
							: "border-surface-elevated bg-surface",
					]}
				>
					<span
						class:list={[
							"text-xs tracking-[0.12em] uppercase",
							category.highlight ? "text-accent-hover" : "text-text-muted",
						]}
					>
						{category.tag ?? "\u00a0"}
					</span>
					<span class="font-display text-xl font-medium tracking-[-0.01em] transition-transform duration-200 ease-(--ease-out-expo) group-hover:translate-x-1 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0 sm:text-2xl">{category.label}</span>
				</a>
			))
		}
	</div>
</section>
