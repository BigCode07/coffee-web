---
import { categories } from "../config/site";
---

<section aria-labelledby="cat-title" class="container-page py-10 md:py-14">
	<h2 id="cat-title" class="mb-7 font-display text-[32px] font-semibold">
		Explorá por categoría
	</h2>
	<div
		class="grid grid-cols-2 gap-3 sm:grid-cols-[repeat(auto-fill,minmax(200px,1fr))] sm:gap-4"
	>
		{
			categories.map((category, i) => (
				<a
					href="#destacados"
					class:list={[
						"flex min-h-20 flex-col justify-between rounded-md border p-4 text-text no-underline transition-colors hover:border-accent sm:min-h-28 sm:p-5",
						category.highlight
							? "col-span-2 border-border bg-surface-elevated sm:col-span-1"
							: "border-surface-elevated bg-surface",
					]}
				>
					<span
						class:list={[
							"text-xs tracking-[0.12em] uppercase",
							category.highlight ? "text-accent-hover" : "text-text-muted",
						]}
					>
						{String(i + 1).padStart(2, "0")}
						{category.tag && ` · ${category.tag}`}
					</span>
					<span class="font-display text-xl sm:text-2xl">{category.label}</span>
				</a>
			))
		}
	</div>
</section>
