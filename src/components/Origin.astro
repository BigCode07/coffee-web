---
import { originText, processSteps } from "../config/site";
---

<section
	id="origen"
	class="container-page section-y flex flex-wrap items-center gap-8 md:gap-14"
>
	<div
		class="flex aspect-[16/9] flex-[1_1_380px] md:aspect-[5/4] items-center justify-center rounded-md border border-dashed border-border bg-surface p-6 text-center text-[13px] tracking-[0.08em] text-text-muted uppercase"
	>
		Foto de finca / tostadero
	</div>
	<div class="flex flex-[1_1_440px] flex-col gap-5">
		<h2 class="section-title">De la finca a tu taza</h2>
		<p class="text-[17px] text-text-muted">{originText}</p>
		<ol class="mt-3 flex list-none flex-col border-b border-surface-elevated">
			{
				processSteps.map((step, i) => (
					<li class="flex gap-4.5 border-t border-surface-elevated py-4">
						<span class="w-10 font-display text-[1.75rem] leading-none font-light text-accent tabular-nums">
							{i + 1}
						</span>
						<div>
							<strong class="font-semibold">{step.title}</strong>
							<p class="mt-1 text-[15px] text-text-muted">
								{step.description}
							</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>
