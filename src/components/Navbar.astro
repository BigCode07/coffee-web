---
import { navLinks, site } from "../config/site";
---

<header class="sticky top-0 z-10 border-b border-surface bg-bg/90 backdrop-blur">
	<nav
		aria-label="Principal"
		class="container-page flex items-center justify-between gap-8 py-4"
	>
		<a
			href="#top"
			class="font-display text-[26px] font-bold tracking-[0.02em] text-text no-underline"
			>{site.brand}</a
		>
		<ul class="hidden items-center gap-7 text-[15px] md:flex">
			{
				navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="text-text no-underline transition-colors hover:text-accent-hover"
							>{link.label}</a
						>
					</li>
				))
			}
		</ul>
		<div class="flex items-center gap-2">
			<button
				type="button"
				aria-label="Buscar"
				data-soon
				class="inline-flex size-11 cursor-pointer items-center justify-center text-text"
			>
				<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
			</button>
			<button
				type="button"
				aria-label="Mi cuenta"
				data-soon
				class="hidden size-11 cursor-pointer items-center justify-center text-text md:inline-flex"
			>
				<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>
			</button>
			<button
				type="button"
				aria-label="Carrito"
				data-soon
				class="inline-flex size-11 cursor-pointer items-center justify-center text-text"
			>
				<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14l-1.5 12h-11z"></path><path d="M9 7V5a3 3 0 0 1 6 0v2"></path></svg>
			</button>
			<button
				type="button"
				id="menu-toggle"
				aria-label="Abrir menú"
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="inline-flex size-11 cursor-pointer items-center justify-center text-text md:hidden"
			>
				<svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			</button>
		</div>
	</nav>
	<ul
		id="mobile-menu"
		hidden
		class="container-page flex flex-col gap-1 pb-4 md:hidden!"
	>
		{
			navLinks.map((link) => (
				<li>
					<a
						href={link.href}
						class="flex min-h-11 items-center text-text no-underline"
						>{link.label}</a
					>
				</li>
			))
		}
	</ul>
</header>

<script>
	const toggle = document.getElementById("menu-toggle");
	const menu = document.getElementById("mobile-menu");

	if (toggle && menu) {
		const setOpen = (open: boolean) => {
			menu.hidden = !open;
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
		};
		toggle.addEventListener("click", () => setOpen(menu.hidden));
		menu.querySelectorAll("a").forEach((a) =>
			a.addEventListener("click", () => setOpen(false)),
		);
	}
</script>
