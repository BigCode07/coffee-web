---
import { products } from "../config/site";
import ProductCard from "./ProductCard.astro";
import ArrowIcon from "./ArrowIcon.astro";
---

<section id="destacados" class="container-page section-y">
	<div class="mb-9 flex flex-wrap items-end justify-between gap-4">
		<div>
			<h2 class="section-title">Los favoritos de la semana</h2>
		</div>
		<a
			href="#destacados"
			class="group inline-flex items-center gap-1.5 text-accent-hover underline decoration-accent/40 underline-offset-[0.35em] transition-colors duration-150 hover:text-text hover:decoration-current text-[15px]"
			>Ver toda la tienda<ArrowIcon size={16} class="transition-transform duration-200 ease-(--ease-out-expo) group-hover:translate-x-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-x-0" /></a
		>
	</div>
	<div
		role="region"
		aria-label="Cafés destacados"
		tabindex="0"
		class="-mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto overscroll-x-contain px-6 pt-1 pb-3 [scrollbar-color:var(--color-border)_transparent] [scrollbar-width:thin] sm:mx-0 sm:grid sm:grid-cols-[repeat(auto-fill,minmax(240px,1fr))] sm:gap-6 sm:overflow-visible sm:px-0 sm:pt-0 sm:pb-0"
	>
		{
			products.map((product) => (
				<div class="flex w-65 shrink-0 snap-start sm:w-auto [&>article]:flex-1">
					<ProductCard product={product} />
				</div>
			))
		}
	</div>
</section>
